# Local app server
HOST=127.0.0.1
PORT=3100

# Cloudflare R2 (required for upload; bucket is fixed: family-share)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Existing Link2Stream worker origin used to build family links.
# Public streaming works as: <origin>/public/files/<objectKey>
L2S_PUBLIC_BASE_URL=https://link2stream-api.link2stream.workers.dev
