{
  "name": "@link2stream/uploader",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone media processing and upload service for Link2Stream.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch backend/main.ts",
    "start": "node dist/backend/main.js",
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
