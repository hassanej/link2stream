# Server
PORT=3000

# FFmpeg x264 preset: ultrafast, superfast, veryfast, faster,
# fast, medium (default), slow, slower, veryslow, placebo.
# Use veryfast on small (1 vCPU) VPS instances.
FFMPEG_PRESET=medium

# Cloudflare R2 (required for upload / storage-usage features)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: public bucket URL used to build shareable links after upload
R2_PUBLIC_URL=
